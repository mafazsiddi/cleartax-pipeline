{
  "name": "mira-kanban",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run server\" \"vite\"",
    "start": "node --env-file-if-exists=.env server/index.js",
    "server": "node --env-file-if-exists=.env server/index.js",
    "client": "vite",
    "gmail-auth": "node --env-file-if-exists=.env scripts/gmail-auth.js",
    "build": "vite build",
    "vercel-build": "node db/migrate.js && vite build",
    "preview": "vite preview",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env db/seed.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.4",
    "emoji-picker-react": "^4.19.1",
    "express": "^4.19.2",
    "lucide-react": "^0.344.0",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.4.1",
    "pg": "^8.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "drizzle-kit": "^0.28.1",
    "vite": "^5.1.4"
  }
}
